            <!-- MAIN DEBATE TOPIC CARD -->
            <div class="relative frosted-card rounded-3xl border border-slate-200/90 shadow-xl shadow-slate-200/60 px-5 py-6 sm:px-10 sm:py-8 text-center overflow-hidden">
