<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Youth Parliament — Modi Institute of Management &amp; Technology</title>

    <!-- Google Fonts: Outfit (Modern Geometric Display) & Plus Jakarta Sans (Clean UI/Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Custom Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['Outfit', 'system-ui', '-apple-system', 'Segoe UI', 'sans-serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'Segoe UI', 'sans-serif'],
                    },
                    keyframes: {
                        fadeUp: {
                            '0%': { opacity: '0', transform: 'translateY(12px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        popIn: {
                            '0%': { opacity: '0', transform: 'scale(0.96)' },
                            '100%': { opacity: '1', transform: 'scale(1)' },
                        },
                        shake: {
                            '0%, 100%': { transform: 'translateX(0)' },
                            '20%, 60%': { transform: 'translateX(-6px)' },
                            '40%, 80%': { transform: 'translateX(6px)' },
                        }
                    },
                    animation: {
                        'fade-up': 'fadeUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        'pop-in': 'popIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        'shake': 'shake 0.32s ease-in-out',
                    }
                }
            }
        };
    </script>

    <!-- Modern Civic Summit / Tech Visual Styling -->
    <style>
        body {
            background-color: #f8fafc;
            background-image:
                radial-gradient(at 10% 6%, rgba(99, 102, 241, 0.14) 0px, transparent 48%),
                radial-gradient(at 90% 10%, rgba(14, 165, 233, 0.13) 0px, transparent 46%),
                radial-gradient(at 50% 96%, rgba(20, 184, 166, 0.11) 0px, transparent 50%),
                radial-gradient(at 88% 82%, rgba(99, 102, 241, 0.08) 0px, transparent 44%);
            background-attachment: fixed;
        }

        /* Subtle Architectural Dot Grid Texture */
        .bg-dot-grid {
            background-image: radial-gradient(rgba(15, 23, 42, 0.055) 1px, transparent 1px);
            background-size: 24px 24px;
        }

        /* Frosted Glass Card Surface */
        .frosted-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        /* Modern Gradient Heading */
        .heading-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 42%, #3730a3 80%, #0284c7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        /* Clean Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen text-slate-900 font-sans antialiased selection:bg-indigo-600/15 selection:text-indigo-900 overflow-x-hidden flex flex-col bg-dot-grid">

    <!-- ==================== TOP UTILITY BAR ==================== -->
    <div class="sticky top-0 z-30 w-full">
        <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 pt-3.5 pb-2 flex items-center justify-between gap-2">
            <!-- Live Sync Status Pill (with tooltip on error) -->
            <button id="sync-status-pill" type="button" title="Real-time Firebase connection status"
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50/90 backdrop-blur-md border border-amber-200/90 shadow-sm text-[11px] sm:text-xs font-semibold text-amber-800 transition-all focus:outline-none">
                <span id="sync-status-dot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span id="sync-status-text">Syncing...</span>
            </button>

            <!-- Right Controls: Sound Toggle, Fullscreen Toggle, Admin Lock -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <!-- Sound Chime Toggle -->
                <button id="btn-sound-toggle" type="button" title="Toggle Vote Sound Chime" aria-label="Toggle Sound"
                    class="p-2.5 rounded-xl bg-white/85 hover:bg-white text-slate-600 hover:text-indigo-600 border border-slate-200/90 shadow-sm backdrop-blur-md transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
                    <!-- Icon injected by JS -->
                </button>

                <!-- Fullscreen Projector Toggle -->
                <button id="btn-fullscreen" type="button" title="Toggle Fullscreen Projector View" aria-label="Toggle Fullscreen"
                    class="p-2.5 rounded-xl bg-white/85 hover:bg-white text-slate-600 hover:text-indigo-600 border border-slate-200/90 shadow-sm backdrop-blur-md transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                    </svg>
                </button>

                <!-- Admin Button -->
                <button id="btn-top-admin" type="button" title="Organizer Admin Access"
                    class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-white/85 hover:bg-white text-slate-700 hover:text-indigo-700 border border-slate-200/90 shadow-sm backdrop-blur-md transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/30">
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    <span id="label-top-admin">Admin</span>
                </button>
            </div>
        </div>

        <!-- ==================== HELPFUL SYNC ERROR NOTICE (SHOWN ONLY ON PERMISSION / NETWORK ERROR) ==================== -->
        <div id="sync-error-banner" class="hidden max-w-4xl mx-auto px-3.5 sm:px-6 mt-1.5 animate-pop-in">
            <div class="rounded-2xl bg-rose-50/95 backdrop-blur-md border border-rose-200 px-4 py-2.5 text-xs sm:text-sm text-rose-800 flex items-center justify-between gap-3 shadow-sm">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span id="sync-error-banner-text">Sync error detected.</span>
                </div>
                <button id="btn-retry-sync" type="button"
                    class="shrink-0 px-3 py-1 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white transition-colors">
                    Retry
                </button>
            </div>
        </div>

        <!-- ==================== FLOATING ADMIN TOOLBAR (VISIBLE ONLY WHEN UNLOCKED) ==================== -->
        <div id="admin-control-bar" class="hidden max-w-6xl mx-auto px-3.5 sm:px-6 mt-1.5 animate-pop-in">
            <div class="rounded-2xl bg-slate-900/95 backdrop-blur-xl text-white border border-slate-700/80 shadow-xl shadow-slate-900/20 px-3 sm:px-4 py-2.5 flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2 pl-1">
                    <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                    <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-indigo-300">Admin Mode</span>
                </div>

                <div class="flex flex-wrap items-center gap-1.5">
                    <button id="btn-bar-edit" type="button"
