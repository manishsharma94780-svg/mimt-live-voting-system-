                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-[11px] font-bold uppercase tracking-widest mb-3">
                    Debate Motion
                </div>

                <h2 id="vote-topic-display"
                    class="font-display text-xl sm:text-3xl lg:text-[2.15rem] font-bold text-slate-900 leading-snug tracking-tight max-w-4xl mx-auto">
                    Should Artificial Intelligence be strictly regulated by global parliamentary law?
                </h2>

                <!-- Optional Total Votes Cast Counter (Toggled by Admin; individual counts stay hidden) -->
                <div id="vote-total-wrapper" class="mt-4 sm:mt-5 flex justify-center">
